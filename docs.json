{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Qint",
  "description": "Accept crypto payments. Settle in CHF, EUR or USD.",
  "colors": {
    "primary": "#3D5AFE",
    "light": "#8C9EFF",
    "dark": "#2A3EB1"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://qint.ch"
  },
  "favicon": "/favicon.svg",
  "api": {
    "openapi": "openapi.yaml",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript", "php", "python"]
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Accept payments",
            "pages": [
              "accept-payments/payment-links",
              "accept-payments/invoices",
              "accept-payments/api-payments",
              "accept-payments/assets-and-networks"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "webhooks/overview",
              "webhooks/verifying-signatures",
              "webhooks/events",
              "webhooks/delivery-and-retries"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/woocommerce",
              "guides/underpayments",
              "guides/payouts",
              "guides/going-live"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Merchant API",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Payment intents",
            "pages": [
              "api-reference/create-intent",
              "api-reference/get-intent",
              "api-reference/list-intents"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@qint.ch"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.qint.ch"
    }
  },
  "footer": {
    "socials": {
      "website": "https://qint.ch"
    }
  }
}
